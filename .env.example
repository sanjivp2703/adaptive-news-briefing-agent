# Copy to .env (or export in your shell). Only live calls need a key; the
# demo, the test suite, the offline harness and the whole console do not.
ANTHROPIC_API_KEY=

# Optional: where the SQLite store lives (default: data/conversational_agent.db)
# CONVAGENT_DB=/path/to/store.db

# Optional: re-route any call without a code change, e.g.
# MODEL_MATERIALITY=claude-sonnet-5
# EFFORT_BRIEFING=low

# Optional: put a local, OpenAI-compatible model in the briefing seat
# LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL_NAME=qwen2.5:3b
# LOCAL_MODEL_POINTS=briefing
