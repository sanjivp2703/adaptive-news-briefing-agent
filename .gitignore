# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Secrets and local config
.env
.env.*
!.env.example

# Runtime stores. The product's SQLite file is per-machine state, never source.
data/
*.db
*.db-wal
*.db-shm

# Evaluation and proposer output. Reproducible from the harness; the numbers
# that matter are recorded in docs/checkpoints.md.
eval-runs/
proposals/*
!proposals/README.md

# Training data and model artifacts. Regenerated by training/*.py.
training/data/*
!training/data/README.md
!training/data/sample_rows.jsonl
*.gguf
*.safetensors

# Third-party text fetched while researching persona reply style. Kept on disk
# as a cache for the scripts that built it; not ours to redistribute.
harness/personas/research/_hn_cache/
harness/personas/research/_wildchat_cache/
harness/personas/generated/_cache/

# OS / editor
.DS_Store
